{
  "rules": {
    "users": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "billing": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },
    "hosts": {
      ".read": false,
      ".write": false,
      "$host_id": {
        ".read": true,
        "is_online": { ".write": true },
        "last_seen": { ".write": true },
        "tunnel_url": { ".write": true },
        "local_url": { ".write": true },
        "pc_name": { ".write": true },
        "pair_token": { ".write": true },
        "wake_token": { ".write": true },
        "host_id": { ".write": true },
        "settings": { ".write": true },
        "usage": {
          ".read": true,
          ".write": false
        }
      }
    }
  }
}
