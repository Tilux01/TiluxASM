{
  "name": "tilux-client",
  "version": "1.0.0",
  "description": "Tilux AI Assistant",
  "author": "Tilux <tilux@example.com>",
  "homepage": "https://example.com/tilux",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.tilux.asm",
    "productName": "Tilux",
    "executableName": "Tilux",
    "publish": {
      "provider": "generic",
      "url": "https://example.com/downloads"
    },
    "directories": {
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "../tilux_engine_dist",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/*.c",
          "!**/*.log",
          "!**/*.bat",
          "!**/.env*",
          "!**/database.rules.json",
          "!**/firebase.json",
          "!**/diagnose*",
          "!**/*.build/**",
          "!**/*.pyc"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tilux",
      "include": "build/installer.nsh"
    },

    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    }
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}