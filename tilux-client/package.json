{
  "name": "tilux-client",
  "version": "1.0.0",
  "description": "Tilux AI Assistant",
  "author": "Tilux <tilux@example.com>",
  "homepage": "https://example.com/tilux",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.tilux.asm",
    "productName": "Tilux",
    "executableName": "Tilux",
    "publish": {
      "provider": "generic",
      "url": "https://example.com/downloads"
    },
    "directories": {
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "../tilux_engine_dist",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/*.c",
          "!**/*.log",
          "!**/*.bat",
          "!**/.env*",
          "!**/database.rules.json",
          "!**/firebase.json",
          "!**/diagnose*",
          "!**/*.build/**",
          "!**/*.pyc",
          "!**/brain.py",
          "!**/sfdcr.py",
          "!**/vault.py",
          "!**/credentials.py",
          "!**/actions.py",
          "!**/cloud_bridge.py",
          "!**/usage_tracker.py",
          "!**/reflex_router.py",
          "!**/os_protocols.py",
          "!**/os_protocol.py",
          "!**/mac_permissions.py",
          "!**/executors/file_executor.py",
          "!**/executors/media_executor.py",
          "!**/executors/messaging_executor.py",
          "!**/executors/browser_executor.py",
          "!**/user_personal.json",
          "!**/memory.json",
          "!**/chat_sessions.json",
          "!**/host_id.txt",
          "!**/pair_token.txt"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tilux",
      "include": "build/installer.nsh"
    },

    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Tilux needs microphone access for hands-free voice assistant and offline wake word listening.",
        "NSScreenCaptureUsageDescription": "Tilux needs screen recording access to assist with desktop automation.",
        "NSAppleEventsUsageDescription": "Tilux needs automation access to control apps and media on your Mac."
      }
    }
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}