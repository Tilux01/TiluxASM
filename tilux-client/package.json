{
  "name": "tilux-client",
  "version": "1.0.0",
  "description": "Tilux AI Assistant",
  "author": "Tilux <tilux@example.com>",
  "homepage": "https://example.com/tilux",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.tilux.asm",
    "productName": "Tilux ASM",
    "publish": {
      "provider": "generic",
      "url": "https://example.com/downloads"
    },
    "directories": {
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "../tilux_engine_dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": ["AppImage", "deb", "rpm", "snap", "pacman"],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "win": {
      "target": ["nsis", "msi"],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    }
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}
